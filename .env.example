# ChAiMa configuration. Copy to `.env` for local dev, or provide these as
# environment variables to the container. All variables are prefixed CHAIMA_.

# --- Security (set these before exposing the app to a network) ---

# Signing key for login/JWT tokens. MUST be a private, random value in
# production — the shipped default is public and lets anyone forge tokens.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a DIFFERENT value per environment (local vs. container).
CHAIMA_SECRET_KEY=

# Initial superuser, seeded only on the very first startup (when no superuser
# exists yet). Set a real password — the default is "changeme".
CHAIMA_ADMIN_EMAIL=admin@example.com
CHAIMA_ADMIN_PASSWORD=

# Optional tripwire: when true, the app REFUSES to start while the secret key
# or admin password are still the shipped defaults. Recommended `true` for the
# container so a misconfiguration fails loudly instead of running insecure.
# Leave false/unset for local dev.
CHAIMA_REQUIRE_SECURE_CONFIG=false

# Marks auth cookies as Secure (HTTPS-only). Keep true in production (behind
# TLS / a tunnel). Set false only when testing over plain HTTP on a LAN,
# otherwise the browser rejects the cookie and login appears to fail.
CHAIMA_COOKIE_SECURE=true

# --- Deployment ---

# Database. Default is a local SQLite file; in a container point this at a
# mounted volume, or use Postgres, e.g.
#   postgresql+asyncpg://user:pass@db:5432/chaima
CHAIMA_DATABASE_URL=sqlite+aiosqlite:///./chaima.db

# Public base URL used to build invite links (e.g. https://chaima.example.com).
# When unset, links fall back to window.location.origin, which can leak
# localhost if an admin generates an invite from the dev machine.
CHAIMA_PUBLIC_BASE_URL=

# --- Optional features ---

# Google AI Studio API key for label OCR (Gemini 2.5 Flash).
# Leave empty to disable the photo-to-container feature.
CHAIMA_GEMINI_API_KEY=
CHAIMA_GEMINI_MODEL=gemini-2.5-flash
